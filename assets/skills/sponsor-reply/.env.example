# OPTIONAL. scripts/yt_stats.py looks for the API key in this order:
#   1. the real environment
#   2. this .env (next to SKILL.md)
#   3. ~/.secrets/globals.env
# and accepts either YOUTUBE_API_KEY or GOOGLE_API_KEY.
#
# If your key already lives in ~/.secrets/globals.env you do NOT need this file
# at all -- keeping the key in one place beats copying it around.

YOUTUBE_API_KEY=

# Which channel to pull. Handle is easiest.
YOUTUBE_CHANNEL_HANDLE=
# YOUTUBE_CHANNEL_ID=
